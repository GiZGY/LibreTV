# 基本配置
PORT=8080
# 至少 16 位，生产环境建议使用 `openssl rand -base64 32`
PASSWORD=replace-with-a-long-random-password
DEBUG=false

# CORS 配置（同源部署留空；多个允许来源用逗号分隔）
CORS_ORIGIN=
# 仅当自建反向代理会覆盖 X-Forwarded-For 时启用
TRUST_PROXY_HEADERS=false

# 请求配置
REQUEST_TIMEOUT=5000
MAX_RETRIES=2
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36

# 安全配置
BLOCKED_HOSTS=localhost,127.0.0.1,0.0.0.0,::1
BLOCKED_IP_PREFIXES=192.168.,10.,172.
FILTERED_HEADERS=content-security-policy,cookie,set-cookie,x-frame-options,access-control-allow-origin

# TVBox bridge（服务端专用，不会注入到前端页面）
# 使用 TOKEN 时 URL 必须是公网 HTTPS 地址；始终禁止 127.0.0.1、192.168.x.x、10.x、172.16-31.x 等内网地址。
TVBOX_BRIDGE_URL=
TVBOX_BRIDGE_TOKEN=
TVBOX_BRIDGE_TIMEOUT_MS=8000
TVBOX_BRIDGE_MAX_INFLIGHT=48
TVBOX_BRIDGE_MAX_RESPONSE_BYTES=2097152
