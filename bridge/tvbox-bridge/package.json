{
  "name": "openstream-tvbox-bridge",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "description": "OpenStream TVBox source bridge for VPS runtime",
  "scripts": {
